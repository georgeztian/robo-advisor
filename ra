#!/usr/bin/env bash
# Run the robo-advisor inside the project's private environment (.venv), creating it first
# if needed. Usage: ./ra <command> [options]   e.g.  ./ra run --interactive --provider yahoo
#                   ./ra test                   runs the test suite
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
if [[ ! -x "$here/.venv/bin/robo-advisor" ]]; then
  echo "Private environment not found - running first-time setup ..."
  "$here/setup.sh"
fi
if [[ "${1:-}" == "test" ]]; then
  shift
  cd "$here" && exec "$here/.venv/bin/python" -m pytest -q "$@"
fi
exec "$here/.venv/bin/robo-advisor" "$@"
